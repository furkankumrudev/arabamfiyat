# ArabamFiyat.com local settings

# SQLite database path. Relative paths are resolved from the project root.
SQLITE_DB_PATH=data/runtime/vehicle_listings.sqlite3

# Comma-separated allowed frontend origins. Keep the local defaults for development.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Daily maintenance pipeline schedule, in UTC. Used by the scheduler process.
PIPELINE_HOUR=3
PIPELINE_MINUTE=0

# Run the pipeline once at startup in addition to the daily schedule.
PIPELINE_RUN_ON_START=false
